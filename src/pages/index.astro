---

<Layout>
  <!-- Hero-section -->
  <section class="bg-sky-base">
    <!-- Reloj -->
    <div>reloj</div>
    <div>Contador</div>
    <div class="flex flex-col text-center items-center justify-center">
      <p>OFERTA ESPECIAL</p>
      <h1 class="flex flex-col">
        <span>DÚO CEVICHATO</span>
        <span>S/.20</span>
      </h1>
    </div>
    <div class="flex flex-col gap-3.5">
      <div>COMBO 01</div>
      <div>COMBO 02</div>
    </div>
    <p>
      Reserva y asegura un dúo puedes recojerlo en tienda o te lo enviamos a
      casa
    </p>
    <button>OBTENER DÚO CON S/.10</button>
    <div class="bg-yellow-base">OFERTA LIMITADA - STOCK LIMITADO</div>
  </section>
</Layout>
