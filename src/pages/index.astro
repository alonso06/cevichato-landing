---
import Hero from "../components/sections/Hero.astro";
import ProducCard from "../components/ui/ProducCard.astro";
import Layout from "../layouts/Layout.astro";

const products = [
  {
    imgUrl: "https://picsum.photos/300/200",
    name: "ceviche de pescado",
    description:
      "Pescado troceado, cebolla, ají limo, limón, culantro, choclo, camote y leche de tigre (secreto de la casa).",
  },
  {
    imgUrl: "https://picsum.photos/300/200",
    name: "ceviche de pescado",
    description:
      "Pescado troceado, cebolla, ají limo, limón, culantro, choclo, camote y leche de tigre (secreto de la casa).",
  },
  {
    imgUrl: "https://picsum.photos/300/200",
    name: "ceviche de pescado",
    description:
      "Pescado troceado, cebolla, ají limo, limón, culantro, choclo, camote y leche de tigre (secreto de la casa).",
  },
  {
    imgUrl: "https://picsum.photos/300/200",
    name: "ceviche de pescado",
    description:
      "Pescado troceado, cebolla, ají limo, limón, culantro, choclo, camote y leche de tigre (secreto de la casa).",
  },
];
---

<Layout>
  <Hero />
  <section class="py-5">
    <div class="px-[0.938em]">
      <h2 class="text-sky-base text-[2em]">CONOCE EL DETALLE</h2>
      <hr class="border-brown-base border w-2/5 ml-2 -rotate-1" />
    </div>
    <!-- card -->
    <div class="max-w-96 mx-auto mt-4">
      {
        products.map(({ imgUrl, name, description }) => {
          return (
            <ProducCard imgUrl={imgUrl} name={name} description={description} />
          );
        })
      }
    </div>
  </section>
</Layout>
