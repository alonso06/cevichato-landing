---
import Faq from "../components/sections/Faq.astro";
import Hero from "../components/sections/Hero.astro";
import Location from "../components/sections/Location.astro";
import DonwloadMenu from "../components/ui/DonwloadMenu.astro";
// import Products from "../components/sections/Products.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Hero />
  <Location />
  <div
    class="px-[0.938em] py-5 flex flex-row gap-4 items-center bg-yellow-base/30 md:px-9 lg:gap-12 lg:px-18 lg:py-10"
  >
    <p id="others-options" class="text-sky-base text-2xl lg:text-[2em]">
      ¿Se te antoja algo más?
    </p>
    <svg
      width="81"
      height="15"
      viewBox="0 0 81 15"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M80.7071 8.07112C81.0976 7.6806 81.0976 7.04743 80.7071 6.65691L74.3431 0.292946C73.9526 -0.0975785 73.3195 -0.0975785 72.9289 0.292946C72.5384 0.68347 72.5384 1.31664 72.9289 1.70716L78.5858 7.36401L72.9289 13.0209C72.5384 13.4114 72.5384 14.0446 72.9289 14.4351C73.3195 14.8256 73.9526 14.8256 74.3431 14.4351L80.7071 8.07112ZM0 7.36401V8.36401H80V7.36401V6.36401H0V7.36401Z"
        fill="#0B8CF1"></path>
    </svg>
    <DonwloadMenu />
  </div>
  <Faq />
</Layout>
