---
import Hero from "../components/sections/Hero.astro";
import Location from "../components/sections/Location.astro";
import Products from "../components/sections/Products.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Hero />
  <Products />
  <Location />
  <section class="bg-white-base py-5">
    <div class="px-[0.938em]">
      <h2 class="text-sky-base text-[2em]">PREGUNTAS FRECUENTES</h2>
      <hr class="border-brown-base border w-2/5 ml-2 -rotate-1" />
    </div>
    <div class="max-w-96 mx-auto mt-5 text-brown-v2-base">
      <div>
        <button
          type="button"
          id=""
          class="w-full flex items-start justify-left gap-3 py-2 text-left"
          aria-expanded="open"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="icon icon-tabler icons-tabler-filled icon-tabler-caret-down"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M18 9c.852 0 1.297 .986 .783 1.623l-.076 .084l-6 6a1 1 0 0 1 -1.32 .083l-.094 -.083l-6 -6l-.083 -.094l-.054 -.077l-.054 -.096l-.017 -.036l-.027 -.067l-.032 -.108l-.01 -.053l-.01 -.06l-.004 -.057v-.118l.005 -.058l.009 -.06l.01 -.052l.032 -.108l.027 -.067l.07 -.132l.065 -.09l.073 -.081l.094 -.083l.077 -.054l.096 -.054l.036 -.017l.067 -.027l.108 -.032l.053 -.01l.06 -.01l.057 -.004l12.059 -.002z"
            ></path></svg
          >
          <span class="question text-2xl uppercase"
            >¿Cuánto es el costo del delivery?</span
          >
        </button>
        <hr class="border-brown-base border ml-2" />
      </div>
      <div class="grid transition-all duration-300 ease-out">
        <div class="overflow-hidden">
          <p class="px-5 pb-5 leading-relaxed">answer</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
