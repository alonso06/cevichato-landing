---
import SocialNetworkLink from "./SocialNetworkLink.astro";
---

<footer class="bg-transparent h-16">
  <div class="flex items-center justify-center py-4">
    <nav class="flex gap-8.5 h-full">
      <SocialNetworkLink
        href="https://www.tiktok.com/@cevichato.pe"
        description="Sigue a cevichato en tiktok"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-sky-base h-8 hover:stroke-brown-v2-base"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M21 7.917v4.034a9.948 9.948 0 0 1 -5 -1.951v4.5a6.5 6.5 0 1 1 -8 -6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917"
          ></path></svg
        >
      </SocialNetworkLink>
      <SocialNetworkLink
        href="https://www.instagram.com/cevichato.pe/"
        description="Sigue a cevichato en instagram"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-sky-base h-8 hover:stroke-brown-v2-base"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
          ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path
            d="M16.5 7.5v.01"></path></svg
        >
      </SocialNetworkLink>
      <SocialNetworkLink
        href="https://wa.link/ijqu0n"
        description="Nuestro número de whastapp"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-sky-base h-8 hover:stroke-brown-v2-base"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path
            d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
          ></path></svg
        >
      </SocialNetworkLink>
      <SocialNetworkLink
        href="https://www.facebook.com/Cevichatoo/"
        description="Sigue a cevichato en facebook"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-sky-base h-8 hover:stroke-brown-v2-base"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
          ></path></svg
        >
      </SocialNetworkLink>
    </nav>
  </div>
</footer>
