---
interface Props {
  id: string;
  question: string;
  answer: string;
}

const { id, question, answer } = Astro.props;
---

<div class="faq-item px-2.5 pt-2.5 pb-5 md:px-0">
  <button
    type="button"
    id={id}
    class="faq-trigger w-full flex items-start justify-left gap-3 py-2 text-left"
    aria-expanded="false"
    aria-controls={`${id}-answer`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="faq-icon shrink-0 w-7 h-7 fill-brown-v2-base transition-transform duration-300"
      aria-hidden="true"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path
        d="M18 9c.852 0 1.297 .986 .783 1.623l-.076 .084l-6 6a1 1 0 0 1 -1.32 .083l-.094 -.083l-6 -6l-.083 -.094l-.054 -.077l-.054 -.096l-.017 -.036l-.027 -.067l-.032 -.108l-.01 -.053l-.01 -.06l-.004 -.057v-.118l.005 -.058l.009 -.06l.01 -.052l.032 -.108l.027 -.067l.07 -.132l.065 -.09l.073 -.081l.094 -.083l.077 -.054l.096 -.054l.036 -.017l.067 -.027l.108 -.032l.053 -.01l.06 -.01l.057 -.004l12.059 -.002z"
      ></path>
    </svg>

    <span
      class="question text-xl uppercase text-sky-base md:text-[1.563em] lg:text-3xl"
    >
      {question}
    </span>
  </button>

  <hr class="border-brown-base border ml-2" />

  <div
    id={`${id}-answer`}
    class="grid grid-rows-[0fr] mt-3 transition-all duration-300 ease-out"
    role="region"
    aria-labelledby={id}
  >
    <div class="overflow-hidden">
      <p
        class="text-brown-v2-base px-5 leading-relaxed text-xl md:text-[1.563em] lg:text-3xl"
      >
        {answer}
      </p>
    </div>
  </div>
</div>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(".faq-trigger");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";

      triggers.forEach((t) => {
        t.setAttribute("aria-expanded", "false");

        const icon = t.querySelector<SVGElement>(".faq-icon");
        icon?.classList.remove("rotate-180");

        const panelId = t.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        panel?.classList.replace("grid-rows-[1fr]", "grid-rows-[0fr]");
      });

      if (!isOpen) {
        trigger.setAttribute("aria-expanded", "true");

        const icon = trigger.querySelector<SVGElement>(".faq-icon");
        icon?.classList.add("rotate-180");

        const panelId = trigger.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        panel?.classList.replace("grid-rows-[0fr]", "grid-rows-[1fr]");
      }
    });
  });
</script>
