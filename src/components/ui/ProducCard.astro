---
interface Props {
  imgUrl: string;
  name: string;
  description: string;
}

const { imgUrl, name, description } = Astro.props;
console.log(imgUrl);
---

<div class="flex flex-col contain object-cover max-h-full mb-5">
  <img class="rounded-lg" src={imgUrl} alt={name} />
  <div class="mt-2.5 flex flex-col gap-2.5">
    <h3 class="text-sky-base text-2xl uppercase">{name}</h3>
    <p class="text-brown-v2-base text-xl uppercase">
      {description}
    </p>
  </div>
</div>
