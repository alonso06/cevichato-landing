---
interface Props {
  targetDate: string;
}

const { targetDate } = Astro.props;

const labels = ["DÍAS", "HORAS", "MINUTOS", "SEGUNDOS"];
---

<div
  class="flex flex-col items-center gap-3 md:justify-center md:items-start"
  data-target-date={targetDate}
>
  <p id="title-countdown" class="text-lg md:text-xl">FINALIZA EN:</p>
  <div
    id="items-countdown"
    class="flex items-end gap-3 p-2.5 md:gap-1 lg:px-2.5 lg:py-2"
  >
    {
      labels.map((label, i) => (
        <div class="flex labels-end md:gap-1">
          <div class="flex flex-col items-center min-w-18 md:min-w-20">
            <span
              class="text-[2em] leading-none md:text-4xl lg:text-5xl"
              data-time={label}
            >
              00
            </span>
            <span
              class="
             text-[1em] mt-1 md:text-lg"
            >
              {label}
            </span>
          </div>
          {i < labels.length - 1 && (
            <span class="label-count text-4xl leading-none pb-5 md:pb-3 md:text-4xl">
              :
            </span>
          )}
        </div>
      ))
    }
  </div>
</div>

<script>
  // const container = document.currentScript.parentElement;
  const container = document.querySelector("[data-target-date]");
  if (container) {
    const target = new Date(container.dataset.targetDate).getTime();

    function updateCountdown() {
      const now = Date.now();
      const diff = target - now;

      if (diff <= 0) {
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      if (!container) return;

      const containerDays = container.querySelector('[data-time="DÍAS"]');
      const containerHours = container.querySelector('[data-time="HORAS"]');
      const containerMinutes = container.querySelector('[data-time="MINUTOS"]');
      const containerSeconds = container.querySelector(
        '[data-time="SEGUNDOS"]',
      );

      containerDays.textContent = String(days).padStart(2, "0");

      if (diff <= 3600000) {
        containerDays.classList.add("text-red-500");
        containerHours.classList.add("text-red-500");
        containerMinutes.classList.add("text-red-500");
        containerSeconds.classList.add("text-red-500");
      }

      containerHours.textContent = String(hours).padStart(2, "0");
      containerMinutes.textContent = String(minutes).padStart(2, "0");
      containerSeconds.textContent = String(seconds).padStart(2, "0");
    }
    updateCountdown();
    console.count("Countdown iniciado");
    setInterval(updateCountdown, 1000);
  }
</script>
