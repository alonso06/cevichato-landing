---
const isChalk = true;
const items = [
  { label: "DÍA", value: 10 },
  { label: "HORAS", value: 10 },
  { label: "MINUTOS", value: 10 },
  { label: "SEGUNDOS", value: 10 },
];
---

<div class="flex flex-col items-center gap-3">
  <p id="title-countdown" class="text-lg md:text-3xl">FINALIZA EN:</p>
  <div id="items-countdown" class="flex items-end gap-3 p-2.5 md:gap-5">
    {
      items.map((item, i) => (
        <div key={item.label} class="flex items-end gap-3 md:gap-5">
          <div class="flex flex-col items-center min-w-18 md:min-w-[5rem]">
            <span class="font-bebas text-[2em] md:text-7xl leading-none">
              {item.value}
            </span>
            <span class="text-[1em] md:text-xs tracking-[0.2em] mt-1">
              {item.label}
            </span>
          </div>
          {i < items.length - 1 && (
            <span
              class={`font-bebas text-4xl md:text-6xl leading-none pb-5 md:pb-6 ${
                isChalk ? "chalk-accent" : "text-terracotta"
              }`}
            >
              :
            </span>
          )}
        </div>
      ))
    }
  </div>
</div>
