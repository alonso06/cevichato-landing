---
interface Props {
  name: string;
  item1: string;
  item2: string;
}

const { name, item1, item2 } = Astro.props;
---

<div class="text-center">
  <h2
    class="text-2xl text-brown-base mb-3 underline decoration-wavy decoration-white decoration-2 underline-offset-4 md:text-3xl"
  >
    {name}
  </h2>
  <p id="info-combo" class="text-2xl md:text-3xl">
    <span>{item1} +</span>
    <span class="bg-linear-to-l from-brown-v2-base/55 from-50% rounded-xl"
      >{item2} +</span
    >
    <span class="">1/2 JARRA DE CHICHA MORADA</span>
  </p>
</div>
