---
interface Props {
  startTime: string;
}
const { startTime } = Astro.props;
---

<div
  data-start-date={startTime}
  class="w-22 text-center border border-white-base rounded-lg py-2 px-5 md:py-1"
>
  <p class="text-lg">QUEDAN</p>
  <p class="text-5xl md:text-4xl lg:text-5xl" data-stock>0</p>
</div>

<script>
  import { parse } from "astro:schema";

  let STOCK_INITIAL = 0;
  const LS_KEY = "item_counter_state";
  const CLICK_DELAY = 6 * 60 * 1000; // 6 minutos en ms
  const SCHEDULE_START = Date.now();
  const STATE_VERSION = 0;

  function mulberry32(seed) {
    return function () {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function generateDropSchedule(initialStock, startTime, seed = 42) {
    const rand = mulberry32(seed);
    // const MIN_INTERVAL = 10 * 1000;
    // const MAX_INTERVAL = 30 * 1000;
    // Producción: Cada 3.5 horas disminuirá en 1 para llegar a las 12 del día primero con 3 items
    const DAY_MS = 5 * 60 * 1000;

    const schedule = [];
    const dropsPerDay = 1;
    const days = Math.ceil(initialStock / dropsPerDay); // 10/2 = 5 días

    for (let day = 0; day < days; day++) {
      for (let drop = 0; drop < dropsPerDay; drop++) {
        const index = day * dropsPerDay + drop;
        if (index >= initialStock) break;
        const offset = rand() * DAY_MS;
        schedule.push(startTime + day * DAY_MS + offset);
      }
    }

    return schedule.sort((a, b) => a - b);
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (
          parsed.version === STATE_VERSION &&
          parsed.scheduleStart &&
          Array.isArray(parsed.schedule)
        ) {
          // 1️⃣ Garantizamos que pendingClicks siempre existe al cargar
          if (!Array.isArray(parsed.pendingClicks)) {
            parsed.pendingClicks = [];
          }
          return parsed;
        }
      }
    } catch {}

    const scheduleStart = SCHEDULE_START;
    const schedule = generateDropSchedule(STOCK_INITIAL, scheduleStart);
    const state = {
      version: STATE_VERSION,
      scheduleStart,
      schedule,
      pendingClicks: [],
    };
    saveState(state);
    return state;
  }

  function saveState(state) {
    try {
      localStorage.setItem(
        LS_KEY,
        JSON.stringify({ ...state, version: STATE_VERSION }),
      );
    } catch {}
  }

  function clearState() {
    try {
      localStorage.removeItem(LS_KEY);
    } catch {}
  }

  // 2️⃣ Cuenta drops automáticos + clicks que ya cumplieron los 6 minutos
  function getCurrentStock(state) {
    const now = Date.now();
    const autoDrop = state.schedule.filter((t) => t <= now).length;
    const clickDrop = state.pendingClicks.filter((t) => t <= now).length;
    return Math.max(STOCK_INITIAL - autoDrop - clickDrop, 0);
  }

  const stockEl = document.querySelector("[data-stock]");
  let state = loadState();

  function render() {
    let stock = getCurrentStock(state);

    if (stock <= 1) {
      clearState();
      const scheduleStart = Date.now();
      const schedule = generateDropSchedule(STOCK_INITIAL, scheduleStart);
      state = { scheduleStart, schedule, pendingClicks: [] };
      saveState(state);
      stock = 0;
      STOCK_INITIAL = stock;
    }

    stockEl.textContent = stock;
    stock <= 4
      ? stockEl.classList.add("text-red-500")
      : stockEl.classList.remove("text-red-500");
  }

  // document.addEventListener("sale-click", () => {
  //   const now = Date.now();
  //   // 3️⃣ Guardamos el timestamp en que el click DEBE aplicarse (ahora + 6 min)
  //   state.pendingClicks.push(now + CLICK_DELAY);
  //   saveState(state);
  //   // El stock NO cambia visualmente hasta que pasen los 6 minutos
  // });

  render();
  setInterval(render, 5 * 60 * 1000);
</script>
