---
import ComboCard from "../ui/ComboCard.astro";
import CountDown from "../ui/CountDown.astro";
import ItemCounter from "../ui/ItemCounter.astro";
import SaleButton from "../ui/SaleButton.astro";
---

<!-- Hero-section -->
<section
  class="flex flex-col justify-center items-center bg-[url(/hero-movil.jpg)] md:bg-[url(/Hero-desktop.jpg)] bg-no-repeat bg-cover px-[0.938em] md:px-9 lg:px-18 lg:pt-5"
>
  <div
    class="flex flex-col justify-center items-center gap-3 md:flex md:flex-row md:justify-between md:items-center md:w-3/4"
  >
    <!-- Reloj -->
    <CountDown targetDate="2026-04-26T18:00:00" />
    <!-- Contador -->
    <ItemCounter startTime="2026-04-26T12:00:00" />
  </div>
  <div
    class="flex flex-col text-center items-center justify-center mt-4 mb-5 lg:mt-8.5 lg:mb-4"
  >
    <p
      id="subtitle-hero"
      class="text-xl text-yellow-base md:text-2xl lg:text-[2em]"
    >
      OFERTA ESPECIAL:
    </p>
    <h1 class="flex flex-col gap-1.5 text-brown-base lg:gap-3.5 lg:mt-3">
      <span class="text-4xl lg:text-5xl">DÚO CEVICHATO</span>
      <hr class="border-white-base border w-4/5 ml-2 -rotate-1" />
      <span class="text-[2em] mt-0.5 lg:text-[2.5em]">S/.20</span>
    </h1>
  </div>
  <div
    class="flex flex-col gap-3.5 md:flex md:flex-row lg:items-center lg:justify-center lg:gap-8 2xl:gap-18"
  >
    <ComboCard name="Combo 01" item1="CEVICHE" item2="ARROZ CON MARIZCOS" />
    <ComboCard name="Combo 02" item1="CEVICHE" item2="CHICHARRÓN DE PESCADO" />
  </div>
  <p id="info-hero" class="text-xl mt-3.5 text-center md:text-2xl lg:mt-10">
    Reserva y asegura un dúo. Puedes recogerlo en tienda.
  </p>
  <SaleButton />
</section>
<div
  id="tape-offer"
  class="w-full h-9 flex items-center overflow-hidden bg-yellow-base text-lg text-sky-base py-2 md:text-xl"
>
  <div class="flex w-max whitespace-nowrap animate-scroll">
    <span class="mx-2">OFERTA LIMITADA - STOCK LIMITADO</span>
    <span class="mx-2">OFERTA LIMITADA - STOCK LIMITADO </span>
  </div>
</div>
