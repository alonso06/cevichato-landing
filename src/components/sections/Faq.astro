---
import FaqItem from "../ui/FaqItem.astro";

const faqs = [
  {
    id: "faq-1",
    question: "¿Cuánto es el costo del delivery?",
    answer: "El costo del delivery varía según tu ubicación.",
  },
  {
    id: "faq-2",
    question: "¿Cuánto tiempo demora mi pedido?",
    answer:
      "El tiempo de entrega estimado es de 30 a 45 minutos dependiendo de la distancia y la demanda del momento.",
  },
  {
    id: "faq-3",
    question: "¿Cuáles son los métodos de pago aceptados?",
    answer: "Aceptamos pagos por Yape o Plin.",
  },
];
---

<section class="bg-white-base py-5 md:px-9 lg:px-18 lg:py-10">
  <div class="px-[0.938em] md:px-0">
    <h2 class="text-sky-base text-[2em] md:text-4xl lg:text-[2.5em]">
      RESPONDEMOS TUS PREGUNTAS
    </h2>
    <hr class="border-brown-base border w-70 ml-2 -rotate-1 md:w-86 lg:w-98" />
  </div>
  <div class="max-w-96 mx-auto mt-5 md:max-w-none md:mx-0 lg:mt-10">
    {
      faqs.map(({ id, question, answer }) => (
        <FaqItem id={id} question={question} answer={answer} />
      ))
    }
  </div>
</section>
